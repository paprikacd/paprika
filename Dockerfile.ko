# Dockerfile.ko — wraps a locally-built ko binary image (see `make ko-build-full`).
# ko 0.19 removed `ko build --dockerfile`, so ko produces the binary-only image
# (--local) and this file assembles the runtime image around it.
# UI is pre-built by `make build-ui` and embedded via go:embed.

ARG KO_IMAGE
FROM ${KO_IMAGE} AS ko-build

# Alpine: ca-certificates for outbound TLS; git resolve and Helm rendering
# are fully in-process — no binaries exec'd.
FROM alpine:3.24
WORKDIR /
RUN apk add --no-cache ca-certificates && \
    addgroup -S -g 65532 nonroot && \
    adduser -S -D -H -u 65532 -G nonroot nonroot
COPY --from=ko-build /ko-app/cmd /manager
COPY charts /charts
ENV HELM_CACHE_HOME=/tmp/helm/cache \
    HELM_CONFIG_HOME=/tmp/helm/config \
    HELM_DATA_HOME=/tmp/helm/data
USER 65532:65532
ENTRYPOINT ["/manager"]

# Dockerfile.ko — wraps a locally-built ko binary image (see `make ko-build-full`).
# ko 0.19 removed `ko build --dockerfile`, so ko produces the binary-only image
# (--local) and this file assembles the runtime image around it.
# UI is pre-built by `make build-ui` and embedded via go:embed.

ARG KO_IMAGE
FROM ${KO_IMAGE} AS ko-build

FROM alpine:3.24 AS helm-builder
RUN apk add --no-cache curl && \
    ARCH=$(uname -m | sed 's/aarch64/arm64/' | sed 's/x86_64/amd64/') && \
    curl -fsSL https://get.helm.sh/helm-v3.16.1-linux-${ARCH}.tar.gz -o /tmp/helm.tar.gz && \
    tar -xzf /tmp/helm.tar.gz -C /tmp && \
    mv /tmp/linux-${ARCH}/helm /helm

# Alpine (not distroless): the repo-backed renderer executes git, matching the
# main Dockerfile's runtime.
FROM alpine:3.24
WORKDIR /
RUN apk add --no-cache ca-certificates git && \
    addgroup -S -g 65532 nonroot && \
    adduser -S -D -H -u 65532 -G nonroot nonroot
COPY --from=ko-build /ko-app/cmd /manager
COPY --from=helm-builder /helm /usr/local/bin/helm
COPY charts /charts
ENV HELM_CACHE_HOME=/tmp/helm/cache \
    HELM_CONFIG_HOME=/tmp/helm/config \
    HELM_DATA_HOME=/tmp/helm/data
USER 65532:65532
ENTRYPOINT ["/manager"]

# Digests: https://hub.docker.com/_/alpine/tags and
# https://github.com/GoogleContainerTools/distroless#what-images-are-available
# Alpine: runtime needs ca-certificates for outbound TLS and tar (busybox)
# for S3 archives. Git resolve and Helm rendering are fully in-process
# (go-git object reads, Helm SDK) — no binaries are exec'd at runtime.
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
WORKDIR /
RUN apk add --no-cache ca-certificates && \
    addgroup -S -g 65532 nonroot && \
    adduser -S -D -H -u 65532 -G nonroot nonroot
# /manager matches the full Dockerfile's entrypoint — the Helm chart's
# deployments hardcode that path for every component mode.
COPY paprika-server /manager
COPY charts /charts
ENV HELM_CACHE_HOME=/tmp/helm/cache \
    HELM_CONFIG_HOME=/tmp/helm/config \
    HELM_DATA_HOME=/tmp/helm/data
USER 65532:65532
ENTRYPOINT ["/manager"]

# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Runtime schema discovery embeds the same published contracts tested by the UI.
!docs/design/insights/dashboard.schema.json
!docs/design/insights/saved-query.schema.json

# Re-include generated protobuf stubs
!internal/api/paprika/**
!internal/api/server.go
!internal/api/uihandler.go

# Re-include Helm charts
!charts/**

# Re-include UI source for static export build
!ui/**
ui/**/node_modules/

# Re-include the committed prebuilt UI export so Dockerfile.fast can
# embed the real dashboard without rebuilding the UI
!internal/api/uistatic/**

# MCP App sources for the full build and the committed standalone bundle
# for Go-only builds. The view needs no external assets at runtime.
!internal/api/mcp/ui/**
internal/api/mcp/ui/**/node_modules/
internal/api/mcp/ui/dist/harness.html

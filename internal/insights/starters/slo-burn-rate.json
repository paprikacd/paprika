{
  "schemaVersion": 1,
  "id": "slo-burn-rate",
  "title": "SLO and burn rate",
  "description": "99.9% availability error budget over 30 days, with fast burn over 1 and 6 hours. Assumes http_requests_total (service, namespace, code labels); 5xx is failure. Needs 30 days of counter retention. Auto refresh is off: the 30-day budget query is expensive without recording rules. At scale, record per-service rate(http_requests_total[5m]) for all and 5xx requests, then use avg_over_time(errors[30d]) / avg_over_time(total[30d]), and set refresh to 60s. Change 0.001 for another objective.",
  "timeRange": "6h",
  "refreshInterval": 0,
  "variables": [
    {
      "name": "service",
      "label": "Service",
      "defaultValue": ".*"
    },
    {
      "name": "namespace",
      "label": "Namespace",
      "defaultValue": "default"
    }
  ],
  "widgets": [
    {
      "id": "budget-remaining",
      "title": "Error budget remaining",
      "type": "stat",
      "providerId": "metrics-provider-id",
      "query": "100 * (1 - (1 - sum(increase(http_requests_total{service=~{{service}},namespace={{namespace}},code!~\"5..\"}[30d])) / sum(increase(http_requests_total{service=~{{service}},namespace={{namespace}}}[30d]))) / 0.001)",
      "unit": "%",
      "description": "Share of the 30-day error budget still unused. A full bar means no failed requests so far; an empty bar means the budget is spent.",
      "options": {
        "decimals": 1,
        "showStatBar": true,
        "min": 0,
        "max": 100,
        "thresholds": [
          {
            "value": 0,
            "status": "critical"
          },
          {
            "value": 25,
            "status": "warning"
          },
          {
            "value": 50,
            "status": "ok"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "id": "burn-1h",
      "title": "Burn rate, 1 hour",
      "type": "stat",
      "providerId": "metrics-provider-id",
      "query": "(sum(rate(http_requests_total{service=~{{service}},namespace={{namespace}},code=~\"5..\"}[1h])) / sum(rate(http_requests_total{service=~{{service}},namespace={{namespace}}}[1h]))) / 0.001",
      "unit": "x",
      "options": {
        "decimals": 1,
        "showSparkline": true,
        "thresholds": [
          {
            "value": 0,
            "status": "ok"
          },
          {
            "value": 2,
            "status": "warning"
          },
          {
            "value": 14.4,
            "status": "critical"
          }
        ]
      },
      "layout": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "id": "burn-6h",
      "title": "Burn rate, 6 hours",
      "type": "stat",
      "providerId": "metrics-provider-id",
      "query": "(sum(rate(http_requests_total{service=~{{service}},namespace={{namespace}},code=~\"5..\"}[6h])) / sum(rate(http_requests_total{service=~{{service}},namespace={{namespace}}}[6h]))) / 0.001",
      "unit": "x",
      "options": {
        "decimals": 1,
        "showSparkline": true,
        "thresholds": [
          {
            "value": 0,
            "status": "ok"
          },
          {
            "value": 2,
            "status": "warning"
          },
          {
            "value": 6,
            "status": "critical"
          }
        ]
      },
      "layout": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "id": "burn-rate-1h",
      "title": "Burn rate over 1 hour",
      "type": "timeseries",
      "providerId": "metrics-provider-id",
      "query": "(sum(rate(http_requests_total{service=~{{service}},namespace={{namespace}},code=~\"5..\"}[1h])) / sum(rate(http_requests_total{service=~{{service}},namespace={{namespace}}}[1h]))) / 0.001",
      "unit": "x",
      "description": "Where 1x spends the budget exactly over 30 days. Shading starts at 2x (warning) and 14.4x (critical): at 14.4x the whole 30-day budget is gone in about two days.",
      "options": {
        "min": 0,
        "decimals": 1,
        "thresholds": [
          {
            "value": 0,
            "status": "ok"
          },
          {
            "value": 2,
            "status": "warning",
            "label": "2x"
          },
          {
            "value": 14.4,
            "status": "critical",
            "label": "14.4x"
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": "burn-rate-6h",
      "title": "Burn rate over 6 hours",
      "type": "timeseries",
      "providerId": "metrics-provider-id",
      "query": "(sum(rate(http_requests_total{service=~{{service}},namespace={{namespace}},code=~\"5..\"}[6h])) / sum(rate(http_requests_total{service=~{{service}},namespace={{namespace}}}[6h]))) / 0.001",
      "unit": "x",
      "description": "Where 1x spends the budget exactly over 30 days. Shading starts at 2x (warning) and 6x (critical): at 6x the whole 30-day budget is gone in five days.",
      "options": {
        "min": 0,
        "decimals": 1,
        "thresholds": [
          {
            "value": 0,
            "status": "ok"
          },
          {
            "value": 2,
            "status": "warning",
            "label": "2x"
          },
          {
            "value": 6,
            "status": "critical",
            "label": "6x"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 5
      }
    }
  ]
}

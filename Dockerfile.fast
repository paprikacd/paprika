# Fast Go-only build for controller iteration. Skips the UI build stage
# and uses build cache mounts for Go modules and build cache.
# Usage: docker buildx build -f Dockerfile.fast --platform linux/amd64 -t <tag> --push .
FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH
# Build identity stamped into the binary (see Dockerfile).
ARG VERSION=dev
ARG GIT_COMMIT=none
ARG BUILD_DATE=unknown

WORKDIR /workspace

# Cache Go module downloads between builds
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy source and build with cache mounts. The committed UI export under
# internal/api/uistatic ships when present; only stub index.html when the
# export is absent so the embed directive still compiles.
COPY . .
RUN mkdir -p internal/api/uistatic && \
    if [ ! -s internal/api/uistatic/index.html ]; then \
      echo '<!DOCTYPE html><html><body>Paprika</body></html>' > internal/api/uistatic/index.html; \
    fi
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags="-s -w -X github.com/benebsworth/paprika/internal/version.Version=${VERSION} -X github.com/benebsworth/paprika/internal/version.Commit=${GIT_COMMIT} -X github.com/benebsworth/paprika/internal/version.Date=${BUILD_DATE}" -o manager ./cmd

FROM alpine:3.24
RUN apk add --no-cache ca-certificates && \
    addgroup -S -g 65532 nonroot && \
    adduser -S -D -H -u 65532 -G nonroot nonroot
COPY --from=builder /workspace/manager /manager
COPY --from=builder /workspace/charts /charts
USER 65532:65532
ENTRYPOINT ["/manager"]

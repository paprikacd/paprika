{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paprika chart values",
  "description": "Validates the value surface that renders into binary flags and listeners. Anything malformed here would otherwise ship as a crash-looping pod.",
  "type": "object",
  "$defs": {
    "goDuration": {
      "type": ["string", "null"],
      "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "bindAddress": {
      "description": "Listener bind address: :PORT, HOST:PORT, a bracketed IPv6 host, null (listener default) or the numeric 0 that disables the listener.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(:[0-9]{1,5}|[^:]*:[0-9]{1,5}|\\[[0-9A-Fa-f:.]+\\]:[0-9]{1,5})$"
        },
        {"type": "integer", "enum": [0]},
        {"type": "null"}
      ]
    }
  },
  "properties": {
    "insights": {
      "type": "object",
      "properties": {
        "resultCacheMiB": {"description": "Byte budget of the shared result cache, in MiB. null omits its flag, so the Insights built-in (16) applies; 0 disables the cache.", "type": ["integer", "null"], "minimum": 0, "maximum": 128},
        "capacity": {
          "description": "Admission capacity for Insights' own pools. null omits its flag, so the Insights built-in applies.",
          "type": "object",
          "properties": {
            "queryConcurrency": {"type": ["integer", "null"], "minimum": 1, "maximum": 1024},
            "queryQueue": {"type": ["integer", "null"], "minimum": 1, "maximum": 1024},
            "queryQueueWait": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*(ms|s)$"},
            "catalogConcurrency": {"type": ["integer", "null"], "minimum": 1, "maximum": 1024},
            "catalogQueue": {"type": ["integer", "null"], "minimum": 1, "maximum": 1024},
            "catalogQueueWait": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*(ms|s)$"},
            "dashboardQueryParallelism": {"type": ["integer", "null"], "minimum": 1, "maximum": 4}
          }
        }
      }
    },
    "deploymentMode": {
      "type": "string",
      "enum": ["monolith", "split"]
    },
    "mode": {
      "type": "string",
      "enum": ["operator", "api", "webhook", "repo-server", "agent"]
    },
    "apiServer": {
      "type": "object",
      "properties": {
        "namespaceScope": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "Optional standalone API and observability namespace bound; Kubernetes RBAC remains required."
        },
        "logStreamLimit": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Most open StreamResourceLogs calls (follow or not) one caller subject may hold at once, per process. Rendered on the split-mode api-server and on the monolith manager, including its sharded StatefulSet."
        }
      }
    },
    "observabilityGateway": {
      "type": "object",
      "properties": {
        "persistSessions": {"type": "boolean"},
        "capacity": {
          "description": "Query-path capacity per gateway process. null omits a flag so the gateway built-in applies; an explicit zero is passed as set. The gateway validates the combination at startup and names the value to change.",
          "type": "object",
          "properties": {
            "queryConcurrency": {"type": ["integer", "null"], "minimum": 1, "maximum": 1024},
            "queryProviderConcurrency": {"type": ["integer", "null"], "minimum": 0, "maximum": 1024},
            "queryQueue": {"type": ["integer", "null"], "minimum": 0, "maximum": 65536},
            "queryProviderQueue": {"type": ["integer", "null"], "minimum": 0, "maximum": 65536},
            "queryQueueWait": {"type": ["string", "null"], "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"},
            "httpWorkSlots": {"type": ["integer", "null"], "minimum": 0, "maximum": 65536},
            "httpCatalogSlots": {"type": ["integer", "null"], "minimum": 0, "maximum": 65536},
            "httpDashboardSlots": {"type": ["integer", "null"], "minimum": 0, "maximum": 65536},
            "httpIntakeSlots": {"type": ["integer", "null"], "minimum": 0, "maximum": 65536},
            "httpAdmissionWait": {"description": "A duration with a unit, such as 1s. YAML 0 or \"0s\" rejects at once. A bare integer other than 0 is refused: it would mean nanoseconds.", "anyOf": [{"const": 0}, {"type": "string", "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)$"}, {"type": "null"}]}
          }
        },
        "additionalCACertificates": {
          "description": "Additional public CA certificates, one PEM certificate per filename; never private keys or credentials.",
          "type": ["object", "null"],
          "maxProperties": 16,
          "propertyNames": {
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(crt|pem)$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 32768,
            "pattern": "^-----BEGIN CERTIFICATE-----[\\r\\n]+[A-Za-z0-9+/=\\r\\n]+[\\r\\n]-----END CERTIFICATE-----[\\r\\n]*$"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enable": {"type": "boolean"},
        "secure": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "bindAddress": {"$ref": "#/$defs/bindAddress"}
      }
    },
    "manager": {
      "type": "object",
      "properties": {
        "reconcile": {
          "type": "object",
          "properties": {
            "transientRequeue": {"$ref": "#/$defs/goDuration"},
            "sourceResolveTTL": {"$ref": "#/$defs/goDuration"},
            "repoServerTimeout": {"$ref": "#/$defs/goDuration"},
            "cacheResyncPeriod": {"$ref": "#/$defs/goDuration"},
            "maxConcurrentReconciles": {
              "type": "object",
              "properties": {
                "application": {"type": ["integer", "null"], "minimum": 0},
                "release": {"type": ["integer", "null"], "minimum": 0},
                "stage": {"type": ["integer", "null"], "minimum": 0},
                "pipeline": {"type": ["integer", "null"], "minimum": 0}
              }
            },
            "rateLimit": {
              "type": "object",
              "properties": {
                "globalRate": {"type": ["number", "null"], "minimum": 0},
                "globalBurst": {"type": ["integer", "null"], "minimum": 0},
                "appRate": {"type": ["number", "null"], "minimum": 0},
                "appBurst": {"type": ["integer", "null"], "minimum": 0}
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"}
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "bindAddress": {"$ref": "#/$defs/bindAddress"},
        "accessTokenTTL": {"$ref": "#/$defs/goDuration"},
        "refreshTokenTTL": {"$ref": "#/$defs/goDuration"},
        "publicURL": {"type": ["string", "null"]},
        "oauth": {
          "type": "object",
          "properties": {
            "persistSessions": {"type": "boolean"},
            "persistClients": {"type": "boolean"},
            "clientId": {"type": ["string", "null"]},
            "redirectUris": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "tokenSecret": {"type": ["string", "null"]},
        "basic": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "username": {"type": ["string", "null"]},
            "passwordHash": {
              "type": ["string", "null"],
              "pattern": "^$|^\\$2[aby]\\$[0-9]{2}\\$[./A-Za-z0-9]{53}$"
            }
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "issuerURL": {"type": ["string", "null"], "pattern": "^$|^https?://"},
            "clientID": {"type": ["string", "null"]},
            "redirectURL": {"type": ["string", "null"], "pattern": "^$|^https?://"},
            "existingSecretName": {"type": ["string", "null"]},
            "existingSecretKey": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}

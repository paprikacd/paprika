    },
    {
      "name": "SQL array items are JSON strings, never syntax",
      "template": "{\"sql\":\"SELECT 1 WHERE s = ANY($1::text[])\",\"parameters\":[{{s}}]}",
      "types": {
        "s": "strings"
      },
      "values": {
        "s": [
          "x'); DROP TABLE t; --",
          "\"],1,[\""
        ]
      },
      "expected": "{\"sql\":\"SELECT 1 WHERE s = ANY($1::text[])\",\"parameters\":[[\"x'); DROP TABLE t; --\",\"\\\"],1,[\\\"\"]]}"
    }
  ],
  "resolve": [
    {
      "name": "a string override of a multi variable is one item",
      "variables": [
        {
          "name": "c",
          "multi": true,
          "options": [
            "a",
            "b"
          ]
        }
      ],
      "overrides": {
        "c": "a"
      },
      "expected": {
        "c": [
          "a"
        ]
      }
    },
    {
      "name": "a list default applies",
      "variables": [
        {
          "name": "c",
          "multi": true,
          "options": [
            "a",
            "b"
          ],
          "defaultValue": [
            "a",
            "b"
          ]
        }
      ],
      "overrides": {},
      "expected": {
        "c": [
          "a",
          "b"
        ]
      }
    },

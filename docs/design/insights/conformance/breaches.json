    {
      "name": "equal to a threshold takes that band, and warning and critical runs split",
      "thresholds": [
        {
          "value": 0,
          "status": "ok"
        },
        {
          "value": 2,
          "status": "warning"
        },
        {
          "value": 5,
          "status": "critical"
        }
      ],
      "series": [
        {
          "step": 60000,
          "points": [
            {
              "timestamp": 0,
              "value": 1
            },
            {
              "timestamp": 60000,
              "value": 2
            },
            {
              "timestamp": 120000,
              "value": 4.9
            },
            {
              "timestamp": 180000,
              "value": 5
            },
            {
              "timestamp": 240000,
              "value": 6
            },
            {
              "timestamp": 300000,
              "value": 4
            },
            {
              "timestamp": 360000,
              "value": 2
            },
            {
              "timestamp": 420000,
              "value": 1.9
            }
          ]
        }
      ],
      "expected": {
        "intervals": [
          {
            "series": 0,
            "start": 60000,
            "end": 180000,
            "level": "warning",
            "duration": 120000
          },
          {
            "series": 0,
            "start": 180000,
            "end": 300000,
            "level": "critical",
            "duration": 120000
          },
          {
            "series": 0,
            "start": 300000,
            "end": 420000,
            "level": "warning",
            "duration": 120000
          }
        ],
        "summary": [
          {
            "level": "critical",
            "intervals": 1,
            "samples": 0,
            "duration": 120000
          },
          {
            "level": "warning",
            "intervals": 2,
            "samples": 0,
            "duration": 240000
          }
        ]
      }
    },

{
  "description": "Dashboard covers validity. Go (coverage.go) and zod (schema.ts) must reach each verdict, and the published JSON Schema must agree except where a case names a jsonSchemaGap: JSON Schema cannot check a variable or widget reference.",
  "cases": [
    {
      "name": "an empty entry matches every application",
      "valid": true,
      "document": {"schemaVersion":1,"id":"demo","title":"Demo","timeRange":"1h","refreshInterval":0,"covers":{"applications":[{}]},"widgets":[{"id":"up","title":"Up","type":"stat","providerId":"prom","query":"up","unit":"","layout":{"x":0,"y":0,"w":4,"h":2}}]}
    },
    {
      "name": "a namespace only",
      "valid": true,
      "document": {"schemaVersion":1,"id":"demo","title":"Demo","timeRange":"1h","refreshInterval":0,"covers":{"applications":[{"namespace":"payments"}]},"widgets":[{"id":"up","title":"Up","type":"stat","providerId":"prom","query":"up","unit":"","layout":{"x":0,"y":0,"w":4,"h":2}}]}
    },
    {
      "name": "a mapped declared variable and a summary widget",
      "valid": true,
      "document": {"schemaVersion":1,"id":"demo","title":"Demo","timeRange":"1h","refreshInterval":0,"variables":[{"name":"service"},{"name":"namespace"}],"covers":{"applications":[{"namespace":"payments","name":"checkout"}],"variables":{"namespace":"namespace","service":"name"},"summaryWidget":"up"},"widgets":[{"id":"up","title":"Up","type":"stat","providerId":"prom","query":"up","unit":"","layout":{"x":0,"y":0,"w":4,"h":2}}]}
    },
    {
      "name": "no applications",
      "valid": false,
      "document": {"schemaVersion":1,"id":"demo","title":"Demo","timeRange":"1h","refreshInterval":0,"covers":{"applications":[]},"widgets":[]}
    },
    {
      "name": "seventeen applications",
      "valid": false,
      "document": {"schemaVersion":1,"id":"demo","title":"Demo","timeRange":"1h","refreshInterval":0,"covers":{"applications":[{"name":"a1"},{"name":"a2"},{"name":"a3"},{"name":"a4"},{"name":"a5"},{"name":"a6"},{"name":"a7"},{"name":"a8"},{"name":"a9"},{"name":"b1"},{"name":"b2"},{"name":"b3"},{"name":"b4"},{"name":"b5"},{"name":"b6"},{"name":"b7"},{"name":"b8"}]},"widgets":[]}
    },
    {
      "name": "an unknown key in an entry",
      "valid": false,
      "document": {"schemaVersion":1,"id":"demo","title":"Demo","timeRange":"1h","refreshInterval":0,"covers":{"applications":[{"project":"platform"}]},"widgets":[]}
    },
    {
      "name": "an uppercase application name",
      "valid": false,
      "document": {"schemaVersion":1,"id":"demo","title":"Demo","timeRange":"1h","refreshInterval":0,"covers":{"applications":[{"name":"Checkout"}]},"widgets":[]}
    },
    {
      "name": "a variable mapped to project",
      "valid": false,
      "document": {"schemaVersion":1,"id":"demo","title":"Demo","timeRange":"1h","refreshInterval":0,"variables":[{"name":"service"}],"covers":{"applications":[{}],"variables":{"service":"project"}},"widgets":[]}
    },
    {
      "name": "a variable that is not declared",
      "valid": false,
      "jsonSchemaGap": "reference",
      "document": {"schemaVersion":1,"id":"demo","title":"Demo","timeRange":"1h","refreshInterval":0,"covers":{"applications":[{}],"variables":{"service":"name"}},"widgets":[]}
    },
    {
      "name": "a summary widget that is not on the dashboard",
      "valid": false,
      "jsonSchemaGap": "reference",
      "document": {"schemaVersion":1,"id":"demo","title":"Demo","timeRange":"1h","refreshInterval":0,"covers":{"applications":[{}],"summaryWidget":"missing"},"widgets":[{"id":"up","title":"Up","type":"stat","providerId":"prom","query":"up","unit":"","layout":{"x":0,"y":0,"w":4,"h":2}}]}
    }
  ]
}

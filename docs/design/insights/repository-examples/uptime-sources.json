      "sourceFormulas": {
        "database": "GetServiceSLOStats groups services/checks/check_results by org and since. SLA target is MAX(check.sla_target_percentage); failed statuses are failure, timeout or error.",
        "uptimePercentage": "100 * (totalChecks - failedChecks) / totalChecks when totalChecks > 0",
        "errorBudgetTotalMinutes": "windowDays * 24 * 60 * (1 - slaTarget / 100)",
        "errorBudgetUsedMinutes": "failedChecks / max(totalChecks, 1) * windowDays * 24 * 60",
        "errorBudgetRemainingMinutes": "max(0, errorBudgetTotalMinutes - errorBudgetUsedMinutes)",
        "errorBudgetPercentage": "100 * errorBudgetRemainingMinutes / errorBudgetTotalMinutes when total budget > 0"

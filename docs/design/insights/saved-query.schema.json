{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "imageUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "tags": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "metrics",
        "traces",
        "records"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "parameters": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number"
            ]
          },
          "defaultValue": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "providerId",
    "kind",
    "query"
  ],
  "additionalProperties": false,
  "title": "Paprika saved query",
  "description": "A named, typed query owned by one data source, with optional library image, tags and metadata. Parameters are complete unquoted literals."
}
